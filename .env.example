# =============================================
# Pulse — Environment Variables
# =============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ---- Database (Cloud Free Tiers) ----
# MongoDB Atlas (Free Tier - M0): https://www.mongodb.com/pricing
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pulse?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pulse?retryWrites=true&w=majority

# Upstash Redis or Redis Labs (Free Tier): https://upstash.com/ or https://redis.com/try-free/
# Example: rediss://default:<password>@<endpoint>.upstash.io:31289
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379


# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- AWS S3 (File Storage) ----
AWS_S3_BUCKET=pulse-dev-docs
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Email (Notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- AI Service (Phase 5) ----
OPENAI_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# ---- Application ----
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
